{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: 检查环境",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-c",
                "import sys; print('Python:', sys.version); print('Interpreter:', sys.executable); print('Virtual environment:', sys.prefix != sys.base_prefix)"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Python: 运行当前文件",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["${file}"],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Python: Keil 构建固件",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["${workspaceFolder}/../../04 测试验证/build_keil.py"],
            "options": {
                "cwd": "${workspaceFolder}/../..",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "${command:eide.project.build}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "${command:eide.project.uploadToDevice}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build and flash",
            "type": "shell",
            "command": "${command:eide.project.buildAndFlash}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "${command:eide.project.rebuild}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "${command:eide.project.clean}",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
