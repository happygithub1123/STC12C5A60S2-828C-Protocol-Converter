$NOMOD51
NAME ?C_STARTUP
EXTRN CODE (?C_START)
PUBLIC ?C_STARTUP

?C_C51STARTUP SEGMENT CODE
?STACK SEGMENT IDATA
RSEG ?STACK
DS 1

CSEG AT 0
?C_STARTUP:
    LJMP BRIDGE_START

RSEG ?C_C51STARTUP
BRIDGE_START:
    CLR 0AFH
    ANL 08EH,#0FDH
    MOV R0,#0FFH
    CLR A
CLEAR_IRAM:
    MOV @R0,A
    DJNZ R0,CLEAR_IRAM
    MOV 081H,#?STACK-1
    LJMP ?C_START
END
